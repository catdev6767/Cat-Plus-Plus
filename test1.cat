paw x = 10
paw y = 3
meow x + y
meow x * y
meow x - y
meow x % y
meow 10 / 2
meow 10 / 4

purr add(a, b)
    give a + b

meow add(5, 7)

purr fact(n)
    sniff n <= 1
        give 1
    give n * fact(n - 1)

meow fact(5)

paw i = 1
knead i <= 5
    meow i
    i = i + 1

paw name = "Meo"
meow "Xin chao, " + name + "!"
